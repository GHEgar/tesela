{
    "name": "tesela",
    "version": "0.6.1",
    "description": "Mosaic-identity icon set: five strokes, a dynamic detail tone, four variants and transitions. Core, React and sprite.",
    "keywords": [
        "icons",
        "icon-set",
        "svg",
        "sprite",
        "react",
        "mosaic"
    ],
    "license": "AGPL-3.0-only",
    "author": "Edgar Villarreal",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GHEgar/tesela.git"
    },
    "homepage": "https://github.com/GHEgar/tesela#readme",
    "bugs": {
        "url": "https://github.com/GHEgar/tesela/issues"
    },
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/core/index.d.ts",
            "import": "./dist/core/index.js"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.js"
        },
        "./sprite.svg": "./dist/sprite.svg"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/sprite.ts",
        "prepublishOnly": "npm run build",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "demo": "vite --config demo/vite.config.ts",
        "demo:build": "vite build --config demo/vite.config.ts"
    },
    "peerDependencies": {
        "react": ">=19"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@npmegar/eslint-config": "^0.4.0",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^24.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.12.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "happy-dom": "^20.14.5",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "rotulo": "^0.3.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    },
    "overrides": {
        "eslint-plugin-jsx-a11y": {
            "eslint": "$eslint"
        }
    },
    "publishConfig": {
        "access": "public"
    }
}
